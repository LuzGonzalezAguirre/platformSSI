# platformSSI local/server configuration
# Copy this file to .env and replace every required placeholder.
# Never commit .env.

DJANGO_SECRET_KEY=replace-with-existing-or-generated-secret

POSTGRES_DB=mes_db
POSTGRES_USER=mes_user
POSTGRES_PASSWORD=replace-with-current-postgres-password

REDIS_PASSWORD=replace-with-current-redis-password

PLEX_PROXY_URL=http://host.docker.internal:8001
PLEX_PROXY_SECRET=replace-with-current-plex-proxy-secret

QWALL_PROXY_URL=http://host.docker.internal:8002
QWALL_PROXY_TOKEN=replace-with-current-qwall-proxy-token
QWALL_DB_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};SERVER=replace-server;DATABASE=replace-database;Trusted_Connection=yes;

ACTION_TRACKER_URL=
ACTION_TRACKER_BOT_USER=
ACTION_TRACKER_BOT_PASSWORD=

VITE_API_BASE_URL=http://localhost:8000/api/v1
